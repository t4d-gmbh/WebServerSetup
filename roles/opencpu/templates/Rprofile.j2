local({
  packages <- c({{ opencpu.PRELOAD_PACKAGES | map('to_json') | join(', ') }})
  invisible(lapply(packages, function(package) {
    if (requireNamespace(package, quietly = TRUE)) {
      library(package, character.only = TRUE)
    }
  }))
})
