# start from the base OpenCPU image
FROM {{ opencpu.DOCKER_IMAGE | default("docker.io/opencpu/ubuntu-24.04") }}:{{ opencpu.DOCKER_TAG | default("v2.2.14-2") }}

{% set package_build_enabled = (opencpu.R_PACKAGES | default({}) | length > 0) %}

{% if package_build_enabled %}
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake gfortran git pkg-config libssl-dev libcurl4-openssl-dev libgsl-dev \
    jags libnlopt-dev libudunits2-dev libgdal-dev libgeos-dev libproj-dev \
    libxml2-dev libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
    libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev libwebp-dev \
    libabsl-dev && rm -rf /var/lib/apt/lists/*
{% else %}
RUN apt-get update && apt-get install -y --no-install-recommends libcurl4-openssl-dev && rm -rf /var/lib/apt/lists/*
{% endif %}

ENV R_LIBS_USER=" "

{% if opencpu.PRELOAD_PACKAGES | default([]) | length > 0 %}
COPY Rprofile /etc/opencpu/Rprofile
{% endif %}

{% if package_build_enabled %}
RUN R -e "install.packages('remotes', lib=.Library, repos='{{ opencpu.CRAN_REPOSITORY | default('https://cloud.r-project.org') }}')"
RUN R -e "install.packages(c('rjags', 'glmmTMB'), lib=.Library, repos='{{ opencpu.CRAN_REPOSITORY | default('https://cloud.r-project.org') }}', dependencies=TRUE)"
{% for package_item in opencpu.R_PACKAGES | default({}) | dict2items %}
{% set package = package_item.value %}
{% if package.enabled | default(true) | bool and package.repository is defined %}
ARG {{ package_item.key | upper }}_BRANCH={{ package.branch | default('master') }}
RUN git clone --depth=1 --branch "${{ package_item.key | upper }}_BRANCH" \
      "{{ package.repository }}" /tmp/{{ package_item.key }}
RUN R -e "remotes::install_local('/tmp/{{ package_item.key }}', dependencies=TRUE, upgrade='never', lib=.Library)"
{% elif package.enabled | default(true) | bool and package.source is defined %}
COPY {{ package_item.key }} /tmp/{{ package_item.key }}
RUN R -e "remotes::install_local('/tmp/{{ package_item.key }}', dependencies=TRUE, upgrade='never', lib=.Library)"
{% endif %}
{% endfor %}
RUN R -e "packages <- c({% set ns = namespace(first=true) %}{% for package_item in opencpu.R_PACKAGES | default({}) | dict2items %}{% if package_item.value.enabled | default(true) | bool %}{% if not ns.first %}, {% endif %}'{{ package_item.value.name | default(package_item.key) }}'{% set ns.first = false %}{% endif %}{% endfor %}); stopifnot(all(vapply(packages, function(package) nzchar(find.package(package, lib.loc=.Library, quiet=TRUE)), logical(1))))"
{% endif %}

# Install custom packages
{% for command in opencpu.RUN_R | default([]) %}
RUN R -e "{{ command }}"
{% endfor %}
